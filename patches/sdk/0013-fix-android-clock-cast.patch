+#ifdef __ANDROID__
+// Android NDK libc++ may not expose std::chrono::clock_cast (C++20 feature).
+// Provide a fallback that delegates to time_point_cast when no specialization exists.
+template <class, class>
+struct clock_time_conversion {};
+
+template <class DestClock, class SourceClock, class Duration>
+auto clock_cast(const std::chrono::time_point<SourceClock, Duration>& t) {
+  using SrcDuration = typename SourceClock::duration;
+  using DstDuration = typename DestClock::duration;
+  if constexpr (std::is_same_v<SrcDuration, DstDuration>) {
+    // Same-duration clocks: just re-bind the time point.
+    return std::chrono::time_point<DestClock>(t.time_since_epoch());
+  } else {
+    // Different durations: fall back to time_point_cast on the epoch duration.
+    using CommonDuration = std::common_type_t<SrcDuration, DstDuration>;
+    auto epoch = std::chrono::duration_cast<CommonDuration>(t.time_since_epoch());
+    return std::chrono::time_point<DestClock>(std::chrono::duration_cast<DstDuration>(epoch));
+  }
+}
+#endif
+
