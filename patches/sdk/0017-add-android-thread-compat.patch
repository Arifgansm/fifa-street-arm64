+ * @modified    2026 - Android C++20 thread polyfills
+ */
+
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <type_traits>
+#include <utility>
+
+namespace std {
+
+#ifdef __ANDROID__
+
+// stop_token polyfill for Android (C++20 feature not in NDK libc++)
+class stop_token {
+ public:
+  stop_token() noexcept = default;
+  stop_token(const stop_token&) noexcept = default;
+  stop_token& operator=(const stop_token&) noexcept = default;
+  ~stop_token() = default;
+
+  [[nodiscard]] bool stop_requested() const noexcept { return false; }
+  [[nodiscard]] bool stop_possible() const noexcept { return false; }
+
+  friend bool operator==(const stop_token&, const stop_token&) noexcept { return true; }
+};
+
+class stop_source {
+ public:
+  stop_source() noexcept = default;
+  stop_source(const stop_source&) noexcept = default;
+  stop_source& operator=(const stop_source&) noexcept = default;
+  ~stop_source() = default;
+
+  [[nodiscard]] stop_token get_token() const noexcept { return stop_token(); }
+  [[nodiscard]] bool stop_requested() const noexcept { return false; }
+  bool request_stop() noexcept { return false; }
+};
+
+// jthread polyfill for Android (C++20 feature not in NDK libc++)
+// std::jthread accepts a callable that optionally takes a stop_token as first parameter
+class jthread {
+ public:
+  using id = std::thread::id;
+  using native_handle_type = std::thread::native_handle_type;
+
+  jthread() noexcept = default;
+
+  // Constructor that handles callable with or without stop_token parameter
+  template <typename Function, typename... Args>
+  explicit jthread(Function&& f, Args&&... args) {
+    // Check if the callable takes a stop_token as first parameter
+    using callable_type = std::decay_t<Function>;
+    constexpr bool takes_stop_token = 
+        std::is_invocable_v<callable_type, stop_token, Args...>;
+    
+    if constexpr (takes_stop_token) {
+      // Callable takes stop_token - we'll pass a dummy one
+      thread_ = std::thread(
+          [func = std::forward<Function>(f), 
+           tup = std::make_tuple(std::forward<Args>(args)...)]() mutable {
+            std::apply(
+                [&func](auto&&... args) {
+                  func(stop_token{}, std::forward<decltype(args)>(args)...);
+                },
+                std::move(tup));
+          });
+    } else {
+      // Callable doesn't take stop_token - forward directly
+      thread_ = std::thread(
+          std::forward<Function>(f), std::forward<Args>(args)...);
+    }
+  }
+
+  jthread(jthread&& other) noexcept : thread_(std::move(other.thread_)) {}
+
+  jthread& operator=(jthread&& other) noexcept {
+    if (joinable()) {
+      request_stop();
+      join();
+    }
+    thread_ = std::move(other.thread_);
+    return *this;
+  }
+
+  ~jthread() {
+    if (joinable()) {
+      request_stop();
+      join();
+    }
+  }
+
+  void swap(jthread& other) noexcept { thread_.swap(other.thread_); }
+
+  [[nodiscard]] bool joinable() const noexcept { return thread_.joinable(); }
+  void join() { thread_.join(); }
+  void detach() { thread_.detach(); }
+
+  [[nodiscard]] id get_id() const noexcept { return thread_.get_id(); }
+  [[nodiscard]] native_handle_type native_handle() { return thread_.native_handle(); }
+
+  void request_stop() noexcept {}
+  [[nodiscard]] stop_token get_stop_token() const noexcept { return stop_token(); }
+
+ private:
+  std::thread thread_;
+};
+
+#endif // __ANDROID__
+
+}  // namespace std
