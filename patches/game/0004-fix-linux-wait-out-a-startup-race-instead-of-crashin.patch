Date: Sat, 17 Oct 2026 19:41:18 +0000
Subject: [PATCH] fix(linux): wait out a startup race instead of crashing

Right after the title starts, a worker thread can call sub_82050928
before the object it is handed has its +80 pointer filled in, and reads
guest address 4: on an ARM64 handheld the game crashed on 1 start in
3-5. The call now waits (up to 2 s) for both pointers it reads, then
runs the original.
---
 Installer/recomp-template/CMakeLists.txt      |  1 +
 .../src/startup_race_hooks.cpp                | 52 +++++++++++++++++++
 2 files changed, 53 insertions(+)
 create mode 100644 Installer/recomp-template/src/startup_race_hooks.cpp

diff --git a/Installer/recomp-template/CMakeLists.txt b/Installer/recomp-template/CMakeLists.txt
index c66ae24..1480e7e 100644
--- a/Installer/recomp-template/CMakeLists.txt
+++ b/Installer/recomp-template/CMakeLists.txt
@@ -13,6 +13,7 @@ include(generated/rexglue.cmake)
 # Sources
 set(FIFASTREET_SOURCES
     src/main.cpp
+    src/startup_race_hooks.cpp
 )
 
 if(WIN32)
diff --git a/Installer/recomp-template/src/startup_race_hooks.cpp b/Installer/recomp-template/src/startup_race_hooks.cpp
new file mode 100644
index 0000000..77cf0c7
--- /dev/null
+++ b/Installer/recomp-template/src/startup_race_hooks.cpp
@@ -0,0 +1,52 @@
+// Startup race on fast multi-core hosts.
+//
+// sub_82050928 reads two handles through pointers at +76 and +80 of the
+// object in r3 and passes them on (calls sub_820FE758 and sub_820FE790). Right
+// after the title starts, a worker thread can get there before the thread that
+// builds the object has filled +80 in, and reads guest address 4: the game
+// crashes on 1 start in 3-5 on an ARM64 handheld. On the console those threads
+// run in an order that never lets this happen. Here the call waits (up to 2 s)
+// for both pointers before the original runs, so it sees the finished object.
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <thread>
+
+#include <rex/hook.h>
+#include <rex/logging.h>
+
+REX_EXTERN(__imp__sub_82050928);
+
+namespace {
+
+inline uint32_t LoadGuestU32(uint8_t* base, uint32_t address) {
+  uint32_t value;
+  std::memcpy(&value, rex::memory::GuestPtr(base, address), sizeof(value));
+  return __builtin_bswap32(value);
+}
+
+}  // namespace
+
+REX_HOOK_RAW(sub_82050928) {
+  const uint32_t object = ctx.r3.u32;
+  if (object >= 0x10000u) {
+    const auto start = std::chrono::steady_clock::now();
+    const auto deadline = start + std::chrono::seconds(2);
+    bool waited = false;
+    while (!LoadGuestU32(base, object + 80) || !LoadGuestU32(base, object + 76)) {
+      if (std::chrono::steady_clock::now() >= deadline) {
+        break;
+      }
+      waited = true;
+      std::this_thread::sleep_for(std::chrono::microseconds(200));
+    }
+    if (waited) {
+      REXLOG_WARN("Startup race: waited {} us for object 0x{:08X} to be filled in",
+                  std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count(),
+                  object);
+    }
+  }
+  __imp__sub_82050928(ctx, base);
+}
